# Enter your code here. Read input from STDIN. Print output to STDOUT
from collections import defaultdict

# Read n and m
n, m = map(int, input().split())
d = defaultdict(list)

# Read Group A and store 1-indexed positions
for i in range(1, n + 1):
    d[input()].append(str(i))

# Read Group B and check against the defaultdict
for _ in range(m):
    word = input()
    if word in d:
        print(" ".join(d[word]))
    else:
        print("-1")
